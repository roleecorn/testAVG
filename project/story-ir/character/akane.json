          }
        ],
        "bgm": "spacetime_mystery.mp3",
        "ratio": 1,
        "width": 17,
        "height": 13,
        "firstArrive": [],
        "parallelDo": "",
        "events": {},
        "changeFloor": {},
        "beforeBattle": {},
        "afterBattle": {},
        "afterGetItem": {},
        "afterOpenDoor": {},
