            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "怎麼就突然擅自決定了！",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "梗平",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
