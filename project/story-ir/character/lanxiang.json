              1
            ],
            "text": [
              255,
              255,
              255,
              1
            ],
            "titlefont": 22,
            "textfont": 16,
            "lineHeight": 22,
            "time": 10,
            "letterSpacing": 0,
            "animateTime": 120
          }
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "yo!小哥，我最近手頭緊，借來花花唄？"
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "要不然（拿出蝴蝶刀）這個小伙伴可就飛到你肚子上嘍～"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "那個大哥，有話好說嘛？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "你看天空這麼美麗，空氣多麼清新",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "所以你到底要不要給錢（把刀抵在梗平肚子上）"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "好！我給就是了！",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "算你還算上道……"
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "住手！光天化日之下竟敢強搶民女……",
          "portrait": {
            "code": 20,
            "image": "lanxiang_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "呸！不是！民男！你是想添銀手鐲是不是？",
          "portrait": {
            "code": 20,
            "image": "lanxiang_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "女人，沒你的事，滾"
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "褲腰帶都沒繫好的小毛頭，還想學人強劫？",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
        },
        {
          "kind": "narration",
          "text": "（說罷，藍湘從不知何處拿出一條腰帶，而混混的褲子則掉在地上）"
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "這下該滾的是誰，我想不用說了吧？",
          "portrait": {
            "code": 20,
            "image": "lanxiang_angry.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "混混",
          "text": "……你給我記住"
        },
        {
          "kind": "narration",
          "text": "（混混提著褲腰帶跑了）"
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "是說這位小兄弟，你沒事吧？",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "沒事，相當感謝，不知道該如何報答，我是梗平，請問貴姓？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "本人姓藍名湘，中國古拳法傳人",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
        },
        {
          "kind": "narration",
          "text": "（藍湘從不知何處拿出了一個募款箱）"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "藍師傅，您這是？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "本人正在開展「懦夫救星」計畫，即傳授中國古拳法，急需資金",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "現在捐款，還可以當我的天字第一號弟子喔！",
          "portrait": {
            "code": 20,
            "image": "lanxiang_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "現在只需五千！",
          "portrait": {
            "code": 20,
            "image": "lanxiang_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "誒……",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "拜託啦～我三天沒吃飯了～",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "呃……抱歉",
          "portrait": {
            "code": 10,
            "image": "keng_serious_portrait.png"
          }
        },
        {
          "kind": "narration",
          "text": "(梗平向藍湘秀出了空空如也的皮夾)"
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "呃沒事，這孔夫子有教無類嘛，我不在意有多少，只在乎是否擁有",
          "portrait": {
            "code": 20,
            "image": "lanxiang_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "……這是我今天的午餐錢了",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "narration",
          "text": "(梗平投了一百)"
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "噢！真是太感謝了，我的好徒兒，回去好好休息，為師去麻雀館鑽研國粹去了",
          "portrait": {
            "code": 20,
            "image": "lanxiang_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "藍湘",
          "text": "改日再向我請教！",
          "portrait": {
            "code": 20,
            "image": "lanxiang_surprised.png"
          }
        },
        {
          "kind": "narration",
          "text": "（說罷，藍湘以極快的速度朝麻雀館衝去）"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "畜生啊……",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "akiba.event.complete",
          "eventId": "lanxiang_1"
        },
