            ],
            "text": [
              255,
              255,
              255,
              1
            ],
            "titlefont": 22,
            "textfont": 16,
            "lineHeight": 22,
            "time": 10,
            "letterSpacing": 0,
            "animateTime": 120
          }
        },
        {
          "kind": "comment",
          "text": "【地點：倉庫區】"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "我剛剛過來的時候在雜貨店旁邊發現了古書店啊",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "對吼！附近的那個雜貨店還有這種地方",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "梗平，你真是個天才",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "哈哈！沒什麼啦～",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "narration",
          "text": "[兩人隨後趕往了雜貨店]"
        },
        {
          "kind": "background.show",
          "role": "image",
          "code": 1,
          "image": "ms_bg_bookstore_a_interior.png",
          "opacity": 1,
          "time": 0
        },
        {
          "kind": "comment",
          "text": "【地點：古書店】"
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "噢！找到了！＜如何把惡魔趕回地獄＞",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "怎麼這麼完美符合我們的需求",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "活像給我們挖坑跳一樣",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "總之我們打開看看吧！",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "噢…",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "店主",
          "text": "喂！小伙子！不準白看書！",
          "portrait": {
            "code": 20,
            "image": "juju_shopkeeper.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "不好意思！我立刻買下來！",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "店主",
          "text": "嗯？",
          "portrait": {
            "code": 20,
            "image": "juju_shopkeeper.png"
          }
        },
        {
          "kind": "narration",
          "text": "（店主看了一下梗平）"
        },
        {
          "kind": "dialogue",
          "speaker": "店主",
          "text": "不用錢也行，你稍微讓我看一下",
          "portrait": {
            "code": 20,
            "image": "juju_shopkeeper.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "梗平！拿了書快跑！他是退役驅魔師！",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "蛤？",
          "portrait": {
            "code": 10,
            "image": "keng_angry_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "跑！",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "噢！",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "narration",
          "text": "（梗平撞倒了店主跑走）"
        },
        {
          "kind": "dialogue",
          "speaker": "店主",
          "text": "唉唷！真疼！剛才看到白白的一塊，果然是惡魔！",
          "portrait": {
            "code": 20,
            "image": "juju_shopkeeper.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "店主",
          "text": "等等！果然是什麼來着？而且我為啥這麼疼？",
          "portrait": {
            "code": 20,
            "image": "juju_shopkeeper.png"
          }
        },
        {
          "kind": "narration",
          "text": "（此時在古書店遠方）"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "啊……累死我了",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "我對那個店長的記憶做了處理",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "他一時半回也想不起我們",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "我得先看看這書的真偽",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "不然可能會發生不好的事",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "具體來講？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "全秋葉原……的馬桶會堵塞",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "蛤？",
          "portrait": {
            "code": 10,
            "image": "keng_angry_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "這邊在2000年還真的爆發過一次",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "好了，這不是重點，總之你改天再找我",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "倉庫會合，知道嗎？",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "噢……",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "akiba.event.complete",
          "eventId": "juju_2"
        },
        {
          "kind": "function.call",
