              255,
              1
            ],
            "titlefont": 22,
            "textfont": 16,
            "lineHeight": 22,
            "time": 10,
            "letterSpacing": 0,
            "animateTime": 120
          }
        },
        {
          "kind": "comment",
          "text": "【地點：倉庫區】"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "奇怪？怎麼跑到這來了？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "難道又是修卡的陰毛嗎？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "怎麼可能？而且應該是陰謀才對",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "還是說你想說沒人，講黃色笑話？",
          "portrait": {
            "code": 20,
            "image": "juju_smile.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "欸？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "欸？難不成，你看得到我？",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "呃……是，看得很清楚",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "我的撒旦啊！總算找到人了！（嚎啕大哭）",
          "portrait": {
            "code": 20,
            "image": "juju_sad.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "欸！！！",
          "portrait": {
            "code": 10,
            "image": "keng_angry_portrait.png"
          }
        },
        {
          "kind": "narration",
          "text": "（一段時間後）"
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "噢抱歉，失態了，小人名叫茱茱",
          "portrait": {
            "code": 20,
            "image": "juju_sad.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "如你所見，是個惡魔",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "惡魔？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "我是一個月前被召喚的，但不曉得儀式出了什麼問題",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "找不到召喚我的人，而且我也沒辦法回地獄了",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "你有沒有想過……找專業人士？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "我找了！可他們只想從物理層面消滅我！茱茱：拜託了，梗平大爺，把惡魔趕回地獄也算功德一件！",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "為什麼你會知道我的名字？",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "是我的能力，我還有辦法讓你變雖小",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "具體來講，就是抽卡只能保底，一番賞只能抽最爛的",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "好好好！我幫就是了",
          "portrait": {
            "code": 10,
            "image": "keng_surprised_portrait.png"
          }
        },
        {
          "kind": "image.show",
          "role": "image",
          "code": 20,
          "image": "juju_smile.png"
        },
        {
          "kind": "image.show",
          "role": "cg",
          "code": 30,
          "image": "juju_bbcall.png",
          "loc": [
            112,
            50,
            320,
            220
          ],
          "opacity": 1,
          "time": 0
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "這真是太好了，來，這個bbcall給你"
        },
        {
          "kind": "image.hide",
          "code": 20,
          "async": true
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "按這邊的按鈕，就能呼叫我囉！"
        },
        {
          "kind": "image.hide",
          "code": 30,
          "time": 0
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "雖然我很想回家，但是我不急，你可以一兩天後叫我",
          "portrait": {
            "code": 20,
            "image": "juju_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "茱茱",
          "text": "但你一定要幫我找線索，知道嗎！",
          "portrait": {
            "code": 20,
            "image": "juju_surprised.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "好，我知道了……",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "akiba.event.complete",
          "eventId": "juju_1"
        },
        {
          "kind": "function.call",
          "function": "function () {\n\tcore.plugin.addAkibaEvent({\n\t\t\"id\": \"juju_2\",\n\t\t\"title\": \"古書追逐\",\n\t\t\"locations\": [\"warehouse_district\"],\n\t\t\"floorId\": \"juju_2\",\n\t\t\"once\": true\n\t});\n}"
        },
        {
          "kind": "akiba.return"
        }
      ]
    },
