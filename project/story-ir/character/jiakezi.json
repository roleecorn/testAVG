  "scenes": [
    {
      "id": "jiakezi_1",
      "floor": {
        "floorId": "jiakezi_1",
        "title": "初遇劇本殺",
        "name": "初遇劇本殺",
        "canFlyTo": false,
        "canFlyFrom": false,
        "canUseQuickShop": false,
        "cannotViewMap": true,
        "defaultGround": "ground",
        "images": [
          { "name": "ms_bg_becky_mansion.png", "canvas": "bg", "x": 0, "y": 0 }
        ],
        "ratio": 1,
        "width": 17,
        "height": 13,
        "firstArrive": [],
        "parallelDo": "",
        "events": {},
