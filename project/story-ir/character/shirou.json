              255,
              1
            ],
            "titlefont": 22,
            "textfont": 16,
            "lineHeight": 22,
            "time": 10,
            "letterSpacing": 0,
            "animateTime": 120
          }
        },
        {
          "kind": "narration",
          "text": "經過中華料理店時，被一陣鏗鏘聲吸引"
        },
        {
          "kind": "narration",
          "text": "棄爐灶旁蹲著一位紅髮少年"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "在中華料理店後門當街打鐵？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "...啊！",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "抱歉嚇到你了，我是士郎。",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "你這是在煉銅打鋼還是準備切菜啊？",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "narration",
          "text": "士郎不好意思地擦汗笑了笑"
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "你看後門牆上這張海報。",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "narration",
          "text": "海報寫著『第一屆中華料理店廚刀鍛造大賽』"
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "中華料理店自己舉辦鍛刀大賽！？這活動名稱聽起來就充滿槽點啊！",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "冠軍獎品是夢幻級的『WOK』與稀有隕鐵鋼材。",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "但大賽規定一定要至少兩人組隊參賽，既然你來了就剛好過來幫幫忙吧。",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "只要來個過場就好了。",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "至少兩人組隊？難怪你蹲在這裡發愁。",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "求求你了，如果沒有那個『WOK』的話，瓦搭西！",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "narration",
          "text": "士郎立刻滑跪到梗平面前"
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "那個鋼材一定能賣到好價錢，贏的話那個給你！",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "你想怎樣用也沒有問題！",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "既然你缺一個搞笑...啊不，熱血副手，在下就陪你玩一把吧！",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "真的嗎？太感謝你了，梗平！我剛好缺一個值得信任的搭檔。",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "你對火候掌控或風箱操作有了解嗎？",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "完全不懂！不過要我加油打氣，這無疑令人振奮的！",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "啊哈哈，有熱情就足夠了！",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "士郎",
          "text": "那我們約好在比賽那天就在這邊等吧，請多指教！",
          "portrait": {
            "code": 20,
            "image": "shirou_normal.png"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "梗平",
          "text": "沒問題，在下一定準時到場，不掉鏈子！",
          "portrait": {
            "code": 10,
            "image": "keng_neutral_portrait.png"
          }
        },
        {
          "kind": "akiba.event.complete",
          "eventId": "shirou_1"
        },
        {
          "kind": "function.call",
          "function": "function () { core.plugin.addAkibaEvent({ id: 'shirou_2', title: '規格外的廚刀', locations: ['chinese_restaurant'], floorId: 'shirou_2', once: true }); }"
        },
        {
          "kind": "akiba.return"
        }
      ]
    },
    {
      "id": "shirou_2",
      "floor": {
        "floorId": "shirou_2",
        "title": "規格外的廚刀",
        "name": "規格外的廚刀",
        "canFlyTo": false,
        "canFlyFrom": false,
        "canUseQuickShop": false,
        "cannotViewMap": true,
        "defaultGround": "ground",
        "images": [
          {
            "name": "ms_bg_mapo_shop.png",
