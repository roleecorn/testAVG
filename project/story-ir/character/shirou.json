        "floorId": "shirou_1",
        "title": "初遇鍛刀師",
        "name": "初遇鍛刀師",
        "canFlyTo": false,
        "canFlyFrom": false,
        "canUseQuickShop": false,
        "cannotViewMap": true,
        "defaultGround": "ground",
        "images": [
          {
