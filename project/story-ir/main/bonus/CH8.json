        {
          "kind": "comment",
          "text": "【本段無BGM】"
        },
        {
          "kind": "comment",
          "text": "【背景：ms_bg_maid_cafe】"
        },
        {
          "kind": "background.show",
          "role": "image",
          "code": 1,
          "image": "ms_bg_maid_cafe.png",
          "loc": [
            0,
            0
          ],
          "opacity": 1,
          "time": 0
        },
        {
          "kind": "dialogue",
          "speaker": "東山",
          "text": "不行了差距甚大啊…",
          "portrait": {
            "code": 20,
            "image": "dongshan_normal.png",
            "expression": "normal"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "蘭斯",
          "text": "東湊西湊別說200了，這才100出頭…",
          "portrait": {
            "code": 20,
            "image": "ms_portrait_lance_normal.png",
            "expression": "normal"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "克莉絲",
          "text": "多出來的竟然還有將近一半是沒忍住嘲諷去投了兩道小鋼珠…",
          "portrait": {
            "code": 20,
            "image": "ms_portrait_chris_normal.png",
            "expression": "normal"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "桶至學長(女僕)",
          "text": "一群窮鬼怎麼可能在一天之類拿出兩百萬啊笑",
          "portrait": {
            "code": 20,
            "image": "ms_portrait_tongzhi_maid_normal.png",
            "expression": "normal"
          }
        },
        {
          "kind": "dialogue",
          "speaker": "東山",
          "text": "不管了！就這麼地吧！",
          "portrait": {
            "code": 20,
            "image": "dongshan_normal.png",
            "expression": "normal"
          }
        },
        {
          "kind": "comment",
          "text": "【過場】"
        },
        {
          "kind": "comment",
          "text": "【背景：DLCIKAZUCHI001】"
        },
        {
          "kind": "background.show",
          "role": "image",
          "code": 1,
          "image": "DLCIKAZUCHI001.png",
          "loc": [
            0,
            0
          ],
          "opacity": 1,
          "time": 0
        },
        {
          "kind": "comment",
          "text": "【下面4句不使用立繪】"
        },
        {
          "kind": "dialogue",
          "speaker": "眼神死掉的人",
          "text": "累到懷疑人生"
        },
        {
          "kind": "dialogue",
          "speaker": "眼神死掉的人",
          "text": "這日子啥時是個頭啊"
        },
        {
          "kind": "dialogue",
          "speaker": "眼神死掉的人",
          "text": "希望撿到的本子能填補一些秋葉原的赤字吧…"
        },
        {
          "kind": "dialogue",
          "speaker": "眼神死掉的人",
          "text": "晚安…馬卡巴卡…"
        },
        {
          "kind": "comment",
          "text": "【過場】"
        },
